{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trading-bot/contracts/trading_signal.schema.json",
  "title": "TradingSignal",
  "description": "A signal produced by a strategy or ML model, consumed by the trading_engine.",
  "type": "object",
  "required": ["symbol", "side", "strategy", "generated_at_ms"],
  "properties": {
    "symbol": { "type": "string" },
    "side": { "type": "string", "enum": ["buy", "sell"] },
    "strategy": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "horizon_minutes": { "type": "integer", "minimum": 1 },
    "target_price": { "type": "number", "exclusiveMinimum": 0 },
    "stop_loss": { "type": "number", "exclusiveMinimum": 0 },
    "take_profit": { "type": "number", "exclusiveMinimum": 0 },
    "atr": { "type": "number", "minimum": 0 },
    "metadata": { "type": "object" },
    "generated_at_ms": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
